# --- storage ---------------------------------------------------------------
# Full connection string (takes precedence over the DB_* variables below)
MONGO_URI=mongodb://root:secret@localhost:27017/?authSource=admin
DB_NAME=watch-tower
# Discrete settings, used when MONGO_URI is empty
DB_HOST=localhost
DB_PORT=27017
DB_USER=root
DB_PASS=secret
DB_AUTH_SOURCE=admin

# --- collection ------------------------------------------------------------
# Comma separated: bugcrowd,hackerone,yeswehack,intigriti,local
SOURCES=bugcrowd,hackerone,yeswehack,intigriti
BOUNTY_DATA_BASE_URL=https://raw.githubusercontent.com/arkadiyt/bounty-targets-data/main/data
SCAN_INTERVAL_SECONDS=1800
REQUEST_TIMEOUT=60
WATCH_DIR=
DEACTIVATE_MISSING=true

# --- notifications ---------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=
NOTIFY_ON_FIRST_SEEN=true
NOTIFY_MAX_ITEMS=40

# --- service ---------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8080
LOG_LEVEL=INFO

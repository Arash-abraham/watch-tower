# Base path of the Laravel API as seen by the browser.
# Keep "/api/v2.1" when the app is served behind the nginx proxy or the Vite
# dev server (both proxy /api to the backend).
VITE_API_BASE_URL=/api/v2.1

# Where the Vite dev/preview server forwards /api requests (server side only).
VITE_PROXY_TARGET=http://127.0.0.1:8000

VITE_PORT=5173

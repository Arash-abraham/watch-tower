APP_NAME="Watch Tower"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# --- storage -----------------------------------------------------------------
# The whole platform runs on MongoDB; mysql/sqlite connections are unused.
DB_CONNECTION=mongodb
DB_URI=mongodb://root:secret@127.0.0.1:27017/?authSource=admin
DB_DATABASE=watch-tower
DB_AUTH_SOURCE=admin

# No SQL tables are created, so file-based session/cache keeps `migrate` clean.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- collector (display only) -------------------------------------------------
WATCHTOWER_SOURCES=bugcrowd,hackerone,yeswehack,intigriti,local
WATCHTOWER_SCAN_INTERVAL=1800
WATCHTOWER_TELEGRAM_ENABLED=false
WATCHTOWER_DISCORD_ENABLED=false

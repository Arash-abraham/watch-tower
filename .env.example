# Copy to .env and adjust. docker compose reads this file automatically.
# The API and the collector are configured through the values below.

# --- mongo -----------------------------------------------------------------
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=secret
DB_NAME=watch-tower
MONGO_PORT=27017

# --- api -------------------------------------------------------------------
APP_ENV=local
APP_DEBUG=true
# Leave empty to let the API container generate a key on start (regenerated on
# every restart); set a stable value for anything beyond local development.
APP_KEY=
API_PORT=8000
FRONTEND_URL=http://localhost:5173
LOG_LEVEL=info

# --- collector -------------------------------------------------------------
COLLECTOR_PORT=8080
WATCHTOWER_SOURCES=bugcrowd,hackerone,yeswehack,intigriti,local
WATCHTOWER_SCAN_INTERVAL=1800

# --- notifications ---------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=
WATCHTOWER_TELEGRAM_ENABLED=false
WATCHTOWER_DISCORD_ENABLED=false

# --- dashboard -------------------------------------------------------------
WEB_PORT=5173
